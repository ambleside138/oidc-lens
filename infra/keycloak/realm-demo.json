{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "all",
  "clients": [
    {
      "clientId": "oidc-lens-bff",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "oidc-lens-local-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://localhost:7443/signin-oidc"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "resource-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "oidc-lens-resource-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "workshop",
      "enabled": true,
      "emailVerified": true,
      "email": "workshop@example.test",
      "firstName": "OIDC",
      "lastName": "Workshop",
      "credentials": [{ "type": "password", "value": "oidc-lens-demo", "temporary": false }]
    }
  ]
}
